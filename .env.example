# NovelSync Agents - Environment Configuration Template
#
# IMPORTANT: Never commit real .env files to git
# Copy this file to .env and fill in your values
#
# Example:
#   cp .env.example .env
#   # Edit .env with your real values

# ============================================================================
# PRODUCTION CONFIGURATION (for Cloud Run deployment)
# ============================================================================

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=story-6f89f

# Google AI Studio Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
# IMPORTANT: In production, this is injected from Secret Manager by Cloud Run
# For local development only
GOOGLE_AI_STUDIO_API_KEY=your_api_key_here
GOOGLE_AI_STUDIO_MODEL=gemini-2.5-flash

# Enable/disable local image generation
# Set to false in production (uses external service)
# Set to true for local development
ENABLE_LOCAL_IMAGE_GENERATION=false

# ============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# ============================================================================

# Firestore Emulator (for local development without GCP)
# Uncomment to use local Firestore emulator instead of connecting to GCP
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Local LLM Alternative (use Ollama instead of Google AI Studio)
# Uncomment to use local Ollama for LLM inference
# USE_OLLAMA=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=dolphin3:8b

# Mock Provider (for testing without AI calls)
# Uncomment to use mock responses (no real API calls)
# USE_MOCK=true

# ============================================================================
# DEVELOPER SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Create local .env file:
#    cp .env.example .env
#
# 2. For local development with Google Cloud:
#    - Get API key from: https://aistudio.google.com/app/apikey
#    - Add to .env: GOOGLE_AI_STUDIO_API_KEY=your_key_here
#    - Make sure .env is in .gitignore (it is)
#
# 3. For local development with Firestore emulator:
#    - Start Firebase emulator: firebase emulators:start
#    - Uncomment FIRESTORE_EMULATOR_HOST and FIREBASE_AUTH_EMULATOR_HOST
#
# 4. For local development with Ollama:
#    - Install Ollama: https://ollama.ai
#    - Start Ollama: ollama serve
#    - Uncomment USE_OLLAMA and related variables
#
# 5. For testing without AI calls:
#    - Uncomment USE_MOCK=true
#    - Tests will use mock responses
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# - Never commit .env to git (already in .gitignore)
# - Never share your API key
# - In production, secrets are stored in GCP Secret Manager
# - Rotate API keys every 90 days
# - If you accidentally expose an API key:
#   1. Delete the key in Google AI Studio console
#   2. Create a new API key
#   3. Update Secret Manager
#   4. Redeploy application
