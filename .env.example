# TheTaleTribe Agents - Environment Configuration Template
#
# IMPORTANT: Never commit real .env files to git
# Copy this file to .env and fill in your values
#
# All AI calls route through creditProxy. Start it before running agents:
#   cd creditProxy && docker compose up --build
#   Then set CREDIT_PROXY_URL below and configure the provider in creditProxy/.env

# ============================================================================
# REQUIRED
# ============================================================================

# Google Cloud project (Firestore)
GOOGLE_CLOUD_PROJECT=story-6f89f

# creditProxy gateway — all LLM routing (BYOK, platform, mock) happens here
CREDIT_PROXY_URL=http://localhost:8080

# ============================================================================
# LOCAL DEVELOPMENT
# ============================================================================

# Firestore emulator (avoids real GCP reads during local dev)
# Run: firebase emulators:start (from taleTribe-frontend/)
# FIRESTORE_EMULATOR_HOST=localhost:8080

# PostgreSQL system of record / pgvector (starts with story-data docker compose).
# STORY_DATA_DATABASE_URL=postgres://postgres:postgres@localhost:5433/story_data
# INDEXING_WORKER_ENABLED=true
# Daily embedding passes per user (default 300). Keep aligned with the Cloud
# Functions setting of the same name.
# MAX_INDEX_USAGE=300

# story-data's HTTP API, used by the MCP read tools (required when ENABLE_MCP is
# on in production). STORY_DATA_SERVICE_TOKEN must match SERVICE_TOKEN on the
# story-data side; without it story-data ignores the asserted X-User-ID.
# STORY_DATA_URL=http://localhost:8084
# STORY_DATA_SERVICE_TOKEN=dev-service-token

# Enable/disable local image generation
ENABLE_LOCAL_IMAGE_GENERATION=false

# Assistant overhaul rollout. New capabilities are off by default.
ASSISTANT_API_ENABLED=true
ASSISTANT_EDIT_PROPOSALS_ENABLED=true
ASSISTANT_RESEARCH_ENABLED=false
ASSISTANT_MAX_MODEL_CALLS=8
ASSISTANT_MAX_TOOL_CALLS=20
ASSISTANT_MAX_OUTPUT_TOKENS=2048
ASSISTANT_RUN_TIMEOUT_SECONDS=240
ASSISTANT_MAX_TOOL_RESULT_CHARS=8000
# Prior turns replayed into the prompt (0 disables conversational memory).
ASSISTANT_HISTORY_MAX_MESSAGES=10
ASSISTANT_HISTORY_MAX_CHARS=4000

# Per-user rate limit on POST /agent/execute (requests per minute; 0 = disabled).
# NOTE: limiter state is per-process. With N Cloud Run instances the effective
# ceiling is N * this value. For a true global cap, back the limiter with Redis.
MAX_REQUESTS_PER_MINUTE_PER_USER=20

# How long (seconds) to cache a story's Firestore context across AI calls.
# Bounds Firestore document reads when a user fires several AI actions on the
# same story in quick succession. 0 disables caching. Edits become visible
# after at most this many seconds. Cache is per-process (per Cloud Run instance).
STORY_CONTEXT_CACHE_TTL_SECONDS=30

# Production only (ENVIRONMENT=production): Cloud Run service URL — OIDC token audience.
# Must match the URL Firebase Functions uses in AGENT_SERVICE_URL when calling this service.
# AGENT_SERVICE_URL=https://novelsync-agents-xxxxx-uc.a.run.app

# Production only: Firebase Functions service account email (OIDC token `email` claim).
# FIREBASE_FUNCTIONS_SERVICE_ACCOUNT=story-6f89f@appspot.gserviceaccount.com

# Optional production override: comma-separated trusted caller emails (replaces single SA above).
# ALLOWED_SERVICE_ACCOUNTS=story-6f89f@appspot.gserviceaccount.com,admin@project.iam.gserviceaccount.com

# ============================================================================
# PROVIDER SELECTION
# ============================================================================
#
# Provider is configured in creditProxy/.env via LLM_PROVIDER, not here.
#
# Quick reference:
#   mock    → LLM_PROVIDER=mock          (no API key, canned responses)
#   ollama  → LLM_PROVIDER=ollama        (local LLM, OLLAMA_BASE_URL)
#   gemini  → LLM_PROVIDER=gemini        (GEMINI_API_KEY, platform default)
#   BYOK    → set via user's API key in frontend Settings — no env var needed

# ============================================================================
# MCP SERVER (OAuth 2.1 + owner-scoped story tools, mounted at /mcp)
# ============================================================================
# Serve the MCP server from this instance (default true).
# ENABLE_MCP=true
# Allow MCP clients to CREATE stories and chapters (default false). Requires a
# token granted the stories:write scope; existing read-only tokens are
# unaffected. With this off the write tools are never registered, /register
# rejects stories:write, and discovery stops advertising it.
# ENABLE_MCP_WRITES=false
# OAuth issuer / MCP resource base URL. Defaults to AGENT_SERVICE_URL in
# production, http://localhost:8000 in dev.
# MCP_ISSUER_URL=http://localhost:8000
# Frontend consent page the /authorize flow redirects to. REQUIRED in
# production; defaults to the Vite dev server in dev.
# MCP_CONSENT_URL=http://localhost:5173/mcp-connect
# Per-user rate limit for MCP tool calls (per instance).
# MCP_MAX_REQUESTS_PER_MINUTE_PER_USER=60
# Per-user cap on MCP write tool calls (per instance), applied on top of
# MCP_MAX_REQUESTS_PER_MINUTE_PER_USER. Deliberately tight: it is what keeps a
# burst from outrunning the eventually-consistent story-count cap.
# MCP_MAX_WRITES_PER_MINUTE_PER_USER=6
# Rollout allowlist (default true): only users with mcpAccess/{uid}.status ==
# "granted" may connect or call tools. Grant with `npm run grant-mcp -- <email>`
# from taleTribe-frontend/functions. Set false to open MCP to everyone.
# ENABLE_MCP_ACCESS_ALLOWLIST=true
# How long an allowlist decision is cached per instance. Also the worst-case
# delay before a revocation disconnects an active connection.
# MCP_ACCESS_CACHE_TTL_SECONDS=60
# Per-IP caps on the unauthenticated OAuth endpoints (per instance). /register
# is tighter: it writes a Firestore doc per call with no credential. 0 disables
# a limiter. Discovery (/.well-known/*) is never throttled.
# MCP_REGISTER_REQUESTS_PER_MINUTE_PER_IP=5
# MCP_OAUTH_REQUESTS_PER_MINUTE_PER_IP=30
# Token lifetimes (seconds): access 1h, rotating refresh 30d.
# MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
